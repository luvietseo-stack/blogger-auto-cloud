# Google Gemini AI API Key (Lấy tại: https://aistudio.google.com/app/apikey)
GEMINI_API_KEY=AIzaSy...

# ID của Blog trên Blogger (Lấy từ URL: https://www.blogger.com/blog/posts/XXXXX)
BLOGGER_BLOG_ID=1234567890123456789

# Google Cloud OAuth 2.0 Credentials (Lấy tại: https://console.cloud.google.com/apis/credentials)
GOOGLE_CLIENT_ID=xxxx.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=GOCSPX-xxxx
GOOGLE_REFRESH_TOKEN=1//04xxxx

# Chế độ phát hành: 'schedule' (Lên lịch trước) hoặc 'publish' (Đăng ngay) hoặc 'draft' (Lưu nháp)
POST_MODE=schedule

# Số giờ lên lịch trước (nếu chọn POST_MODE=schedule, ví dụ 24 là hẹn giờ vào ngày mai)
SCHEDULE_HOURS_AHEAD=24

# Cấu hình thương hiệu & CTA LuViet
ZALO_URL=https://zalo.me/1501073926693571291
FANPAGE_URL=https://www.facebook.com/webluviet/
